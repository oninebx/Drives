it('should not render the vacancy question if house is occupied', () => {
  renderComponent(<Page1 />, {
    initialState,
    translationData,
  });

  expect(
    screen.queryByTestId('mock-vacant-date')
  ).not.toBeInTheDocument();
});

it('should render the vacancy question if house is unoccupied', () => {
  const newState = {
    ...initialState,
    myForms: {
      ...initialState.myForms,
      houseClaim: {
        ...initialState.myForms.houseClaim,
        occupancy: OCCUPANCY_EMPTY,
      },
    },
  };

  renderComponent(<Page1 />, {
    initialState: newState,
    translationData,
  });

  expect(
    screen.getByTestId('mock-vacant-date')
  ).toBeInTheDocument();
});