import { screen } from '@testing-library/react';
import * as React from 'react';
import { renderComponent } from '~/common/test-utilities/renderComponent';
import { OCCUPANCY_EMPTY } from '../../shared/state';
import { getDefaultClaimHouseState } from '../state';
import Page1 from './Page1';

/**
 * Keep the child components mocked because Page1 is responsible for
 * composing these components, not for testing their internal UI.
 */
jest.mock('~/feature/claim/house/components', () => ({
  AlarmSet: () => <div data-testid="alarm-set" />,
  AuthorityReportFire: () => <div data-testid="authority-report-fire" />,
  AuthorityReportPolice: () => <div data-testid="authority-report-police" />,
  HouseEventLocation: () => <div data-testid="house-event-location" />,
  HouseLivable: () => <div data-testid="house-livable" />,
  HouseLocked: () => <div data-testid="house-locked" />,
  KeysStolen: () => <div data-testid="keys-stolen" />,
  LastPropertyInspection: () => (
    <div data-testid="last-property-inspection" />
  ),
  Occupancy: () => <div data-testid="occupancy" />,
  OtherPeopleDetail: () => (
    <div data-testid="other-people-detail" />
  ),
  VacantDate: () => <div data-testid="vacant-date" />,
}));

jest.mock('~/feature/claim/shared/components', () => ({
  EventDescription: () => <div data-testid="event-description" />,
  EventLocation: () => <div data-testid="event-location" />,
  FloatingToolbar: () => <div data-testid="floating-toolbar" />,
  FormFooter: () => <div data-testid="form-footer" />,
  PreStepsSummary: () => <div data-testid="pre-steps-summary" />,
  WitnessSection: () => <div data-testid="witness-section" />,
}));

jest.mock('~/feature/claim/shared/components/dumb', () => ({
  ClaimNumber: () => <div data-testid="claim-number" />,
}));

describe('Page1', () => {
  const initialState = {
    myForms: {
      houseClaim: {
        ...getDefaultClaimHouseState(),
        eisClaim: {
          reportedPolicyNumber: 'P0001234',
          causeOfLoss: 'fire',
          lossDate: '2025-09-18T22:59:00.000Z',
        },
      },
      sharedClaim: {
        homePolicyDetails: {
          typeOfPolicy: 'house',
        },
        eventDate: '19 September 2025',
        eventTime: '10:59',
        eventTimeAmPm: 'am',
        policyDetails: {
          description: '123 Fake street Howick Manukau',
        },
      },
    },
  };

  const translationData = {
    'claim/house:headings': {
      page1: 'What happened',
      fire: 'Fire',
      witnesses: 'Witnesses',
      otherPeople: 'Other People',
    },
    'claim:page1': {
      eventDescription: {
        title: 'Describe what happened',
      },
    },
    'claim:reportedToPolice': {
      title: 'Were the police called?',
    },
    'claim:witness': {
      hasWitness: {
        title: 'Did anyone witness the incident?',
      },
    },
    'claim:didFireServiceAttend': {
      title: 'Did fire service attend?',
    },
    'claim/house:occupancy': {
      title: 'Who was living in the property',
    },
    'claim/house:houseLivable': {
      title: 'Is the proprty secure and sage to live in?',
    },
    'claim/house:theft': {
      houseLocked: {
        title: 'was the house locked?',
      },
      alarmSet: {
        title: 'was the alarm set?',
      },
      keysStolen: {
        title: 'were your keys stolen?',
      },
    },
    'claim:footer': {
      nextButton: {
        house: {
          page1: 'Next',
        },
      },
    },
  };

  const theftState = {
    ...initialState,
    myForms: {
      ...initialState.myForms,
      houseClaim: {
        ...getDefaultClaimHouseState(),
        eisClaim: {
          ...initialState.myForms.houseClaim.eisClaim,
          causeOfLoss: 'theft',
          secondaryCauseOfLoss: 'theft',
        },
      },
    },
  };

  describe('page content', () => {
    it('should render the page heading', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByRole('heading', {
          level: 2,
          name: 'What happened',
        })
      ).toBeInTheDocument();
    });

    it('should render PreStepsSummary', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('pre-steps-summary')
      ).toBeInTheDocument();
    });

    it('should render EventDescription', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('event-description')
      ).toBeInTheDocument();
    });

    it('should render FormFooter', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('form-footer')
      ).toBeInTheDocument();
    });
  });

  describe('occupancy and property questions', () => {
    it('should render Occupancy', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('occupancy')
      ).toBeInTheDocument();
    });

    it('should not render LastPropertyInspection for a house claim', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.queryByTestId('last-property-inspection')
      ).not.toBeInTheDocument();
    });

    it('should not render VacantDate when the house is occupied', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.queryByTestId('vacant-date')
      ).not.toBeInTheDocument();
    });

    it('should render VacantDate when the house is unoccupied', () => {
      const unoccupiedState = {
        ...initialState,
        myForms: {
          ...initialState.myForms,
          houseClaim: {
            ...initialState.myForms.houseClaim,
            occupancy: OCCUPANCY_EMPTY,
          },
        },
      };

      renderComponent(<Page1 />, {
        initialState: unoccupiedState,
        translationData,
      });

      expect(
        screen.getByTestId('vacant-date')
      ).toBeInTheDocument();
    });

    it('should render HouseLivable', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('house-livable')
      ).toBeInTheDocument();
    });
  });

  describe('fire claim', () => {
    it('should render fire-related components and not render theft-related components', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('authority-report-fire')
      ).toBeInTheDocument();

      expect(
        screen.queryByTestId('house-locked')
      ).not.toBeInTheDocument();

      expect(
        screen.queryByTestId('alarm-set')
      ).not.toBeInTheDocument();

      expect(
        screen.queryByTestId('keys-stolen')
      ).not.toBeInTheDocument();

      expect(
        screen.queryByTestId('authority-report-police')
      ).not.toBeInTheDocument();
    });
  });

  describe('theft claim', () => {
    it('should render all theft-related components', () => {
      renderComponent(<Page1 />, {
        initialState: theftState,
        translationData,
      });

      expect(
        screen.getByTestId('house-locked')
      ).toBeInTheDocument();

      expect(
        screen.getByTestId('alarm-set')
      ).toBeInTheDocument();

      expect(
        screen.getByTestId('keys-stolen')
      ).toBeInTheDocument();

      expect(
        screen.getByTestId('authority-report-police')
      ).toBeInTheDocument();
    });

    it('should not render fire-related components', () => {
      renderComponent(<Page1 />, {
        initialState: theftState,
        translationData,
      });

      expect(
        screen.queryByTestId('authority-report-fire')
      ).not.toBeInTheDocument();
    });
  });

  describe('witnesses and other people', () => {
    it('should render WitnessSection', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('witness-section')
      ).toBeInTheDocument();
    });

    it('should render OtherPeopleDetail', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('other-people-detail')
      ).toBeInTheDocument();
    });
  });

  describe('event location', () => {
    it('should render HouseEventLocation when event location is enabled', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('house-event-location')
      ).toBeInTheDocument();
    });

    it('should render EventLocation when event location is somewhere else', () => {
      renderComponent(<Page1 />, {
        initialState,
        translationData,
      });

      expect(
        screen.getByTestId('event-location')
      ).toBeInTheDocument();
    });
  });
});